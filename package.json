{
  "name": "openwriter",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-agent writing framework for long-form fiction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/agents -w packages/connectors -w packages/cli",
    "package": "node scripts/package.mjs --all",
    "package:win": "node scripts/package.mjs --platform win32",
    "package:linux": "node scripts/package.mjs --platform linux",
    "package:mac": "node scripts/package.mjs --platform darwin",
    "test": "vitest run",
    "wa": "npx tsx packages/cli/src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
